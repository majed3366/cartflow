{
  "has_raven": true,
  "text_sample": "\u0645\u0644\u062e\u0635 \u062a\u0646\u0641\u064a\u0630\u064a\n\n\u0645\u0627\u0630\u0627 \u064a\u062c\u0628 \u0623\u0646 \u062a\u0639\u0631\u0641 \u0627\u0644\u0622\u0646\u061f\n\n\u0645\u0644\u062e\u0635 \u0633\u0631\u064a\u0639 \u0641\u0642\u0637 \u2014 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u0641\u064a \u0635\u0641\u062d\u0627\u062a\u0647\u0627.\n\n\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u062a\u062c\u0631\n\u064a\u062a\u0637\u0644\u0628 \u0645\u062a\u0627\u0628\u0639\u0629\n\n\u0641\u0631\u0635 \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0645\u062d\u062f\u0648\u062f\u0629 \u0627\u0644\u064a\u0648\u0645.\n\n\u0639\u0631\u0636 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u2190\n\n\u0642\u0631\u0627\u0631\u0627\u062a \u0627\u0644\u064a\u0648\u0645\n2 \u0642\u0631\u0627\u0631\u0627\u062a \u0639\u0645\u0644\n2\n\n\u0631\u0627\u062c\u0639 \u062a\u062c\u0631\u0628\u0629 \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0634\u0631\u0627\u0621 \u0648\u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0639\u0645\u0644\u0627\u0621.\n\n\u0639\u0631\u0636 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u2190 \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0642\u0631\u0627\u0631 \u2190\n\n\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a\n\u064a\u062a\u0637\u0644\u0628 \u0627\u0646\u062a\u0628\u0627\u0647\u0627\u064b\n4\n\n\u0627\u0644\u0645\u0646\u062a\u062c Raven \u2014 \u062d\u0632\u0627\u0645 \u062c\u0644\u062f \u0644\u0644\u0633\u0627\u0639\u0629: \u064a\u062d\u0638\u0649 \u0628\u0627\u0647\u062a\u0645\u0627\u0645 \u0648\u0627\u0636\u062d\u060c \u0644\u0643\u0646 \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0625\u0644\u0649 \u0634\u0631\u0627\u0621 \u0644\u0627 \u064a\u0632\u0627\u0644 \u0645\u0646\u062e\u0641\u0636\u0627\u064b.\n\n\u0639\u0631\u0636 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u2190\n\n\u0627\u0644\u0633\u0644\u0627\u0644\n\u0644\u0627 \u0645\u0647\u0627\u0645\n0\n\n86 \u0633\u0644\u0629 \u0642\u064a\u062f \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u0645\u0639 \u0627\u0644\u0639\u0645\u0644\u0627\u0621.\n\n\u0639\u0631\u0636 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u2190\n\n\u0627\u0644\u062a\u0648\u0627\u0635\u0644\n\u0644\u0627 \u0645\u0647\u0627\u0645\n0\n\n\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u064a\u0633\u064a\u0631 \u0628\u0634\u0643\u0644 \u0637\u0628\u064a\u0639\u064a.\n\n\u0639\u0631\u0636 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u2190\n\n\u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 = \u0645\u0644\u062e\u0635 \u062a\u0646\u0641\u064a\u0630\u064a \u00b7 \u0627\u0644\u0642\u0631\u0627\u0631\u0627\u062a \u0641\u064a \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0642\u0631\u0627\u0631 \u00b7 \u0627\u0644\u0633\u0644\u0627\u0644 \u0644\u0644\u062a\u0634\u063a\u064a\u0644 \u00b7 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0644\u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u00b7 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0644\u0644\u0636\u0628\u0637."
}